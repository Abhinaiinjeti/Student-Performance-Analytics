# EduPulse Analytics - Environment Configuration Example
# Copy this file to .env and configure as needed.

# Application Environment
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-this-in-production-to-a-secure-random-key
PORT=5000
HOST=127.0.0.1

# Storage Paths (relative to application root or absolute)
DATA_DIR=data
LOG_DIR=logs

# PySpark Configuration
SPARK_APP_NAME=EduPulseAnalytics
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=8

# Optional AWS S3 Configuration (Disabled by default)
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=archives/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
